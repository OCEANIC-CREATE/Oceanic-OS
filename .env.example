# Oceanic-OS Configuration
# Copy to .env.local for local development overrides

# Application Settings
APP_NAME=Oceanic-OS
APP_ENV=development
APP_DEBUG=true

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# CORS Settings
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true

# Limits
MAX_IDENTITIES=10000
MAX_EVENTS=100000
PAGINATION_LIMIT=100

# Logging
LOG_LEVEL=INFO
